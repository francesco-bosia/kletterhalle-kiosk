# ============================================
# Stripe Configuration
# ============================================
#
# Get these from https://dashboard.stripe.com/apikeys
#
# BEST PRACTICE: Use Restricted API Keys (RAKs) instead of secret keys.
# RAKs (rk_ prefix) have only the permissions needed for each use case.
# Create RAKs at: https://dashboard.stripe.com/apikeys/create
#
# Required RAK permissions for Terminal + Payments:
#   - terminal.readers.read
#   - terminal.readers.write
#   - terminal.connection_tokens.write
#   - payment_intents.write
#   - checkout_sessions.write
#
STRIPE_SECRET_KEY=rk_test_xxx

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks
# Recommended for server-side event logging and redundancy
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# Stripe Terminal Configuration
# ============================================

# Stripe Terminal Location ID (server-side)
# Get this from https://dashboard.stripe.com/terminal/locations
# This identifies where the card reader is physically located.
# IMPORTANT: test-mode and live-mode locations are separate.
STRIPE_TERMINAL_LOCATION_ID=tml_xxx

# Stripe Terminal — client-side reader discovery
# NOTE: NEXT_PUBLIC_* vars require rebuild after changing (npm run build)
#
# NEXT_PUBLIC_TERMINAL_SIMULATED:
#   - 'false' = physical card reader (production)
#   - 'true' or unset = Stripe simulator (development)
#
# NEXT_PUBLIC_TERMINAL_LOCATION_ID:
#   Must match STRIPE_TERMINAL_LOCATION_ID exactly.
#   Required for the Terminal SDK to discover readers at this location.
#
NEXT_PUBLIC_TERMINAL_SIMULATED=true
NEXT_PUBLIC_TERMINAL_LOCATION_ID=tml_xxx

# ============================================
# App URL & Fulfillment
# ============================================

# NEXT_PUBLIC_BASE_URL:
#   Base URL Stripe redirects back to after a TWINT Checkout
#   (used to build success_url). The app binds to the IPv4 loopback
#   (next start -H 127.0.0.1), and the kiosk browser opens 127.0.0.1, so
#   pin this to the v4 loopback — NOT 'localhost', which can resolve to ::1
#   and miss the v4-only bind, breaking the TWINT return.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# FULFILL_RECONCILE_INTERVAL_MS (optional):
#   How often the in-process reconciliation sweep polls Stripe for paid-but-
#   unfulfilled payments. Defaults to 60000 (60s) if unset. Must be a finite
#   positive number; an invalid value disables the loop.
# FULFILL_RECONCILE_INTERVAL_MS=60000

# ============================================
# Thermal Printer Configuration
# ============================================

# Printer connection type: 'usb' or 'network'
PRINTER_TYPE=usb

# USB Printer Device Path (Linux)
# Find with: ls -la /dev/usb/lp*
PRINTER_DEVICE=/dev/usb/lp0

# Network Printer Configuration (if PRINTER_TYPE=network)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# Printer Test Mode
# Set to 'true' to output receipts to console instead of printer
# Set to 'false' to use real thermal printer
PRINTER_TEST_MODE=true

# ============================================
# Production Checklist
# ============================================
# Before deploying to production:
# 1. Replace test RAK with live RAK (rk_test_xxx → rk_live_xxx)
# 2. Set NEXT_PUBLIC_TERMINAL_SIMULATED=false
# 3. Set PRINTER_TEST_MODE=false
# 4. Verify printer device path is correct
# 5. Confirm reader is registered to live location in Stripe Dashboard
# 6. Ensure reader and kiosk are on same network
# 7. Rebuild app: npm run build
